DEEPSEEK_API_KEY=

# Required only for Zep benchmarks. Start Neo4j separately and fill in its
# actual deployment identity. Never put real credentials in this file.
AGENT_MEMORY_NEO4J_URI=
AGENT_MEMORY_NEO4J_USER=neo4j
AGENT_MEMORY_NEO4J_PASSWORD=
AGENT_MEMORY_NEO4J_DATABASE=neo4j
AGENT_MEMORY_NEO4J_IMAGE=
AGENT_MEMORY_NEO4J_IMAGE_DIGEST=

# Explicit opt-in for tests that call a real LOTUS model.
AGENT_MEMORY_RUN_LOTUS_E2E=0
